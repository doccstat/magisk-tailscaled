#!/system/bin/sh
# Compatibility entry point; the controller, not shell process-name matching, owns the daemon.
MODDIR=/data/adb/modules/magisk-tailscaled
case "${1:-status}" in
 start|stop|restart|status|diagnostics) exec "$MODDIR/bin/tsctl" "${1:-status}" ;;
 log) exec "$MODDIR/bin/tsctl" logs ;;
 *) echo 'Use tsctl status|start|stop|restart|logs|diagnostics; raw tailscale CLI remains available.' >&2; exit 1 ;;
esac
