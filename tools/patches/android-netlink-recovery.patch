+// Rules and routes have different attribute ABIs: FRA_UID_RANGE (20) is
+// eight bytes, whereas RTA_PREF (20) is one byte. Never decode a rule as a route.
+func decodeRuleDeleted(data []byte) (RuleDeleted, bool, error) {
+	var msg rtnetlink.RuleMessage
+	if err := msg.UnmarshalBinary(data); err != nil {
+		return RuleDeleted{}, false, err
+	}
+	table := uint32(msg.Table)
+	var priority uint32
+	if msg.Attributes != nil {
+		if msg.Attributes.Table != nil {
+			table = *msg.Attributes.Table
+		}
+		if msg.Attributes.Priority != nil {
+			priority = *msg.Attributes.Priority
+		}
+	}
+	// RuleDeleted only represents the small table IDs used by Tailscale.
+	// Do not truncate Android's extended IDs into unrelated small tables.
+	if table > 255 {
+		return RuleDeleted{}, false, nil
+	}
+	return RuleDeleted{Table: uint8(table), Priority: priority}, true, nil
+}
