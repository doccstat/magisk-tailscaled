+// Try configured suffixes in order without changing the question seen by the app.
+func (r *Resolver) querySearchDomains(ctx context.Context, query []byte, family string, from netip.AddrPort) ([]byte, bool, error) {
+	var original dns.Message
+	if err := original.Unpack(query); err != nil || original.Response || len(original.Questions) != 1 {
+		return nil, false, nil
+	}
+	question := original.Questions[0]
+	short := strings.TrimSuffix(question.Name.String(), ".")
+	if short == "" || strings.Contains(short, ".") {
+		return nil, false, nil
+	}
+	r.mu.Lock()
+	suffixes := append([]dnsname.FQDN(nil), r.searchDomains...)
+	r.mu.Unlock()
+	ctx, cancel := context.WithTimeout(ctx, dnsQueryTimeout)
+	defer cancel()
+	var last []byte
+	seen := map[dnsname.FQDN]bool{}
+	for _, suffix := range suffixes {
+		if suffix == "" || suffix == "." || seen[suffix] {
+			continue
+		}
+		seen[suffix] = true
+		name, err := dns.NewName(short + "." + string(suffix))
+		if err != nil {
+			continue
+		}
+		candidate := original
+		candidate.Questions = []dns.Question{{Name: name, Type: question.Type, Class: question.Class}}
+		packed, err := candidate.Pack()
+		if err != nil {
+			return nil, false, nil
+		}
+		response, err := r.Query(ctx, packed, family, from)
+		if err != nil {
+			return nil, true, err
+		}
+		var message dns.Message
+		if err = message.Unpack(response); err != nil {
+			return nil, true, err
+		}
+		if !message.Response || message.ID != original.ID || len(message.Questions) != 1 || !strings.EqualFold(message.Questions[0].Name.String(), name.String()) || message.Questions[0].Type != question.Type || message.Questions[0].Class != question.Class {
+			return nil, true, errors.New("invalid search DNS response")
+		}
+		message.Questions[0].Name = question.Name
+		// Link the original name to the answer owner; question-only rewrites
+		// produce answers strict resolvers cannot associate with their query.
+		if message.RCode == dns.RCodeSuccess && len(message.Answers) != 0 {
+			alias := dns.Resource{Header: dns.ResourceHeader{Name: question.Name, Class: question.Class}, Body: &dns.CNAMEResource{CNAME: name}}
+			message.Answers = append([]dns.Resource{alias}, message.Answers...)
+		}
+		message.AuthenticData = false // The synthesized name is not DNSSEC-authenticated.
+		message.Authoritative = false
+		last, err = message.Pack()
+		if err != nil {
+			return nil, true, err
+		}
+		last = checkResponseSizeAndSetTC(last, query, family, r.logf)
+		if message.RCode != dns.RCodeNameError {
+			return last, true, nil
+		}
+	}
+	return last, last != nil, nil
 }
 
